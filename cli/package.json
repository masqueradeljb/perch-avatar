{
  "name": "perch-avatar",
  "version": "0.1.0",
  "description": "A desktop pet that perches on whatever window your agent is working in: MCP server, hooks CLI, and one-command setup for the Perch macOS app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masqueradeljb/perch-avatar.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/masqueradeljb/perch-avatar#readme",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "desktop-pet",
    "mascot",
    "macos"
  ],
  "type": "module",
  "bin": {
    "perch": "dist/cli.js",
    "perch-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
